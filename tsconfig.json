{
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,

    "lib": ["ES2022", "DOM"],
    "types": ["node"],

    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./types",
  },
  "include": ["types"],
}
