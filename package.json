{
  "name": "@hyperttp/types",
  "version": "0.5.2",
  "keywords": [
    "hyperttp",
    "protocol-agnostic",
    "types",
    "typescript"
  ],
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-types.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "oxlint types",
    "lint:fix": "oxlint types --fix",
    "format": "oxfmt types",
    "format:check": "oxfmt types --check",
    "build": "node ../../scripts/build-package.ts",
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2"
  }
}
